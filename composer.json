{
    "name": "gmoaozora/gmo-aozora-api-php",
    "description": "",
    "keywords": [
        "swagger",
        "php",
        "sdk",
        "api",
        "ganb",
        "gmo"
    ],
    "homepage": "https://api.gmo-aozora.com/ganb/developer/api-docs/",
    "license": "proprietary",
    "authors": [
        {
            "name": "GMO Aozora net bank",
            "homepage": "https://api.gmo-aozora.com/ganb/developer/api-docs/"
        }
    ],
    "require": {
        "php": "^8.0",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.15.2",
        "firebase/php-jwt": "^7.0",
        "guzzlehttp/psr7": "^2.12.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.13.6",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Ganb\\Corporate\\Client\\": "corporate/lib/",
            "Ganb\\Personal\\Client\\": "personal/lib/",
            "Ganb\\Webhook\\Client\\": "webhook/lib/",
            "Ganb\\": "auth/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ganb\\Corporate\\Client\\": "corporate/test/",
            "Ganb\\Personal\\Client\\": "personal/test/",
            "Ganb\\Webhook\\Client\\": "webhook/test/"
        }
    },
    "config": {
        "platform": {
            "php": "8.0.0"
        }
    },
    "scripts": {
        "test:jwt": "@php tests/jwt-regression.php --require-strong-keys"
    }
}
